{
  // markdownlint 规则集（渲染级优先）。
  // 依据：AGENTS.md「文档约定」+ engineering-rules R30（配额）+ 本仓中文设计文档的既有排版。
  // 原则：只约束会影响**渲染/可读性**的规则；纯风格差异显式关闭，不制造噪声 diff。
  "default": true,

  // —— 既有排版事实 / 纯风格：显式关闭（不影响渲染）——
  "MD013": false,            // 行长度：中文按句换行，不设硬上限
  "MD033": false,            // 允许内联 HTML（<br>、<backend> 之类占位写法）
  "MD034": false,            // 允许裸 URL/路径（设计文档直接写仓内路径）
  "MD036": false,            // 允许用强调行作小标题（沿革块/表注）
  "MD041": false,            // 首行不必是标题（部分文件以 banner 引用开头）
  "MD046": false,            // 缩进式与围栏式代码块并存（既有设计文档）
  "MD045": false,            // 图片 alt 由作者决定（守则配图）
  "MD060": false,            // 表格管道两侧空格：纯风格，渲染等价；本仓两种写法并存
  "MD004": false,            // 无序列表符号（+/- 混用）：纯风格
  "MD029": false,            // 有序列表编号风格：纯风格
  "MD014": false,            // 代码块示例中的 $ 提示符：是内容
  "MD026": false,            // 标题末尾标点：中文标题常带「：」
  "MD038": false,            // 代码跨度内空格可能是内容（如 ` x `），不自动改写
  "MD010": { "code_blocks": false },  // 制表符：代码块/日志摘录内是内容，只禁止正文里的硬制表符

  // —— 渲染相关：保持开启（本任务的目的）——
  "MD055": true,             // table-pipe-style：表格首尾管道符一致
  "MD056": true,             // table-column-count：列数与表头一致（未转义 | 会错列）
  "MD058": true,             // blanks-around-tables：表格前后空行（否则不渲染为表格）

  // —— 结构性规则：按既有文档放宽到不产生噪声 ——
  "MD024": { "siblings_only": true },   // 同标题允许出现在不同父节下
  "MD032": true,                        // 列表前后空行
  "MD031": true,                        // 围栏代码块前后空行
  "MD022": true,                        // 标题前后空行
  "MD028": true,                        // 引用块内空行
  "MD012": true,                        // 连续空行
  "MD040": false,                       // 围栏语言可省略（既有文档大量无语言）
  "MD047": true                         // 文件以单个换行结尾
}
