{
  // markdownlint-cli2 运行配置（globs / ignores）。规则见 .markdownlint.jsonc。
  // 用法：./gradlew markdownlint  （检查）  ./gradlew markdownlintFix  （自动修复可修项）
  "config": ".markdownlint.jsonc",
  "globs": [
    "*.md",
    "docs/*.md",
    "docs/**/*.md",
    "src/**/*.md",
    "app/**/*.md",
    "profile-core/**/*.md",
    "tools/**/*.md"
  ],
  "ignores": [
    "build/**",
    "**/build/**",
    "node_modules/**",
    ".gradle/**",
    ".git/**",
    // 归档目录是历史快照：不得改写（AGENTS.md「不删历史」/archive 规则）
    "docs/archive/**"
  ]
}
