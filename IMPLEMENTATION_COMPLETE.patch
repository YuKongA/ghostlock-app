# Tracepoint constants for CFI stage (vivo vr.ko neutralization)
# These are extracted from the device's own vmlinux.
# See docs/kernel_profiles/EXTRACT_TRACEPOINT_CONSTANTS.md for extraction guide.
tracepoint {
  sys_exit {
    probestub_off = 48  # 0x30 (no CONFIG_HAVE_STATIC_CALL)
    funcs_off = 72      # 0x48
  }
  commit_creds {
    funcs_off = 72      # 0x48
  }
  func_stride = 24      # sizeof(tracepoint_func)
  vr_commit_to_sys_exit_delta = 96  # 0x60
  kernel_image_max = 37343232  # _end - KIMAGE_TEXT_BASE (example)
}
