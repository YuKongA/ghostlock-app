+/** Maps the executable's terminal result without losing process evidence or profile identity.
+ *
+ * @param state completed or pre-start executable state returned by the selected launcher.
+ * @param profileRelease release identifier of the profile supplied to this run.
+ * @return `Done` only for a successful executable result; failures retain their original reason.
+ * @note The executable host exit status remains the single terminal authority for this step.
+ */
+internal fun map43499ExecutableState(state: BackendRunUiState, profileRelease: String): StepResult =
+    when (state) {
+        is BackendRunUiState.Finished -> when (val result = state.result) {
+            is FlowResult.Ok -> StepResult.Done(result.evidence + ("profile" to profileRelease))
+            is FlowResult.Failed -> StepResult.Failed(
+                result.reason,
+                result.evidence + ("profile" to profileRelease),
+            )
+        }
+        is BackendRunUiState.Refused -> StepResult.Failed(state.reasons.joinToString(","))
+        else -> StepResult.Failed("exec-state-not-finished")
+    }
 
