+  $(patsubst $(DFROOT_SRC)/%.S,$(DFROOT_BUILD_DIR)/%.o,$(DFROOT_ASM_SRCS))
+
+.PHONY: exec-glued
+exec-glued: 43499-glued 43284-glued
+
+43499-glued: $(GLUED_43499_BIN)
