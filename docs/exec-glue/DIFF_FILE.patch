+	$(NDK_CXX) $(CXXFLAGS) -c $< -o $@
+
+.PHONY: cpp-link-probe-test target-constants-test native-resource-test native-host-tests host-attack-dataflow-test lint-tidy
+cpp-link-probe-test: $(HOST_BUILD_DIR)/cpp_link_probe_test
