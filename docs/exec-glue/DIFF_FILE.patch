-            return match.groupValues[4] + "-" + match.groupValues[2]
-        }
-        val kernel = Regex("(\\d+)\\.(\\d+)").find(release) ?: return null
-        return fallbackByKernel[kernel.groupValues[1] + "." + kernel.groupValues[2]]
-    }
-
