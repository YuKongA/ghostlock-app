+	@echo "Building untouched remote/main 43499 as an exec payload"
+	@mkdir -p $(dir $@)
+	$(NDK_CXX) $(OBJS) $(LDFLAGS) -o $@
+
+43284-glued: $(GLUED_43284_BIN)
+
+$(GLUED_43284_BIN): $(DFROOT_OBJS)
+	@echo "Building untouched DFRoot 43284 as an exec payload"
+	@mkdir -p $(dir $@)
+	cd $(DFROOT_SRC) && $(NDK_CC) $(abspath $(DFROOT_OBJS)) -fPIE -pie -pthread -Wl,-z,max-page-size=16384 -llog -o $(abspath $@)
+
+$(DFROOT_BUILD_DIR)/%.o: $(DFROOT_SRC)/%.c $(DFROOT_SRC)/include.inc $(DFROOT_SRC)/df_log.h
+	@mkdir -p $(dir $@)
+	cd $(DFROOT_SRC) && $(NDK_CC) $(CFLAGS) -I. -Wa,-I$(abspath $(DFROOT_SRC)) -fno-stack-protector -fomit-frame-pointer -c $(notdir $<) -o $(abspath $@)
+
+$(DFROOT_BUILD_DIR)/%.o: $(DFROOT_SRC)/%.S $(DFROOT_SRC)/include.inc
+	@mkdir -p $(dir $@)
+	cd $(DFROOT_SRC) && $(NDK_CC) $(CFLAGS) -I. -c $(notdir $<) -o $(abspath $@)
+
+$(GHOSTLOCK_BIN): $(OBJS) Makefile
