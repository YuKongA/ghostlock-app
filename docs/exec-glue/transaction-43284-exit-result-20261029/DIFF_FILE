+/** Maps the executable's authoritative exit result into the enclosing Flow step result.
+ *
+ * @param state completed or pre-start executable state.
+ * @return a step success only for `FlowResult.Ok`; nonzero exits and refusals remain failures.
+ * @note The executable host's exit code is the single terminal authority for this exec step.
+ */
+internal fun map43284ExecutableState(state: BackendRunUiState): StepResult = when (state) {
+    is BackendRunUiState.Finished -> when (val result = state.result) {
+        is FlowResult.Ok -> StepResult.Done(result.evidence)
+        is FlowResult.Failed -> StepResult.Failed(result.reason, result.evidence)
+    }
+    is BackendRunUiState.Refused -> StepResult.Failed(state.reasons.joinToString(","))
+    else -> StepResult.Failed("exec-state-not-finished")
