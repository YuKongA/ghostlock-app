+                    aesKey = key,
+                )
+                return AndroidIpSecRuntime(arguments, key, resources)
+            } catch (problem: Exception) {
+                key.fill(0)
+                resources.close()
+                throw problem
+            }
+        }
+
+        private const val AES_KEY_BYTES = 32
+    }
+}
