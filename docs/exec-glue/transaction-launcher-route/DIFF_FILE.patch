+     * @return the selected launcher's result.
+     * @note Exceptions from the selected launcher propagate; this method never falls back or
+     * starts a second child after an uncertain remote result.
+     */
+    suspend fun <T> dispatch(
+        route: ExecutableProcessRoute,
+        app: suspend () -> T,
+        shizuku: suspend () -> T,
+    ): T = when (route) {
+        ExecutableProcessRoute.APP -> app()
+        ExecutableProcessRoute.SHIZUKU -> shizuku()
+    }
