+    if (directory_fd < 0 || fstat(directory_fd, &directory_stat) != 0) {
+        if (directory_fd >= 0) close(directory_fd);
+        return -1;
+    }
+    int marker_fd = openat(directory_fd, "ROOT_READY", O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
