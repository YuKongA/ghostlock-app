    <string name="boot_auto_run_summary">Run GhostLock automatically after the device unlocks following boot</string>
    <string name="boot_permissions_note_title">Before you enable</string>
    <string name="boot_permissions_note_body">Android grants boot access when GhostLock is installed. You do not need a separate permission for that.\n\nAfter each reboot, unlock the device once. Auto-run starts after unlock and may wait about 15 seconds.\n\nNotifications are optional and show run progress only. Open GhostLock once after install so your CPU core pair is saved.\n\nOn some devices you must allow autostart for GhostLock and disable battery restrictions, or auto-run may not start.</string>
    <string name="boot_permissions_toast">Auto-run at boot is enabled. Allow notifications to see progress.</string>
